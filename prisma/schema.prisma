generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  SHIFT_ADMIN
  SHIFT_CONSULTANT
  CLIENT_VIEWER
  COLLABORATOR
}

enum JobStatus {
  OPEN
  PAUSED
  CLOSED
}

enum EmploymentType {
  CLT
  PJ
  BOTH
}

enum TaskStatus {
  TODO
  IN_PROGRESS
  DONE
  ARCHIVED
}

enum TaskPriority {
  LOW
  MEDIUM
  HIGH
}

enum OnboardingStatus {
  STARTED
  DOCS_PENDING
  SIGNATURE
  COMPLETED
}

enum SignatureStatus {
  PENDING
  SIGNED
  REJECTED
}

model Organization {
  id        String    @id @default(cuid())
  name      String
  tradeName String?
  cnpj      String?
  city      String?
  region    String?
  status    String    @default("ACTIVE")
  archivedAt DateTime?
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  createdById String?
  updatedById String?

  users               User[]
  consultantAccess    UserOrganizationAccess[]
  jobOpenings         JobOpening[]
  pipelineStages      PipelineStage[]
  candidates          Candidate[]
  tasks               Task[]
  employees           Employee[]
  onboardings         Onboarding[]
  auditLogs           AuditLog[]
}

model User {
  id             String        @id @default(cuid())
  email          String        @unique
  name           String
  password       String
  role           UserRole
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  assignedTasks          Task[]                   @relation("TaskAssignee")
  ownedCandidates        Candidate[]              @relation("CandidateOwner")
  responsibleOnboardings Onboarding[]             @relation("OnboardingResponsible")
  organizationAccess     UserOrganizationAccess[]
  employeeProfile        Employee?
  auditLogs              AuditLog[]
  uploadedDocuments      OnboardingDocument[]
}

model UserOrganizationAccess {
  id             String       @id @default(cuid())
  userId         String
  user           User         @relation(fields: [userId], references: [id], onDelete: Cascade)
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdAt      DateTime     @default(now())

  @@unique([userId, organizationId])
}

model PipelineStage {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  name           String
  order          Int
  isTerminal     Boolean      @default(false)
  terminalType   String?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt

  candidates Candidate[]
}

model JobOpening {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  title          String
  area           String?
  seniority      String?
  employmentType EmploymentType @default(CLT)
  quantity       Int            @default(1)
  priority       TaskPriority   @default(MEDIUM)
  status         JobStatus      @default(OPEN)
  ownerName      String?
  openedAt       DateTime       @default(now())
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  updatedById    String?

  candidates Candidate[]
  tasks      Task[]
}

model Candidate {
  id             String        @id @default(cuid())
  organizationId String
  organization   Organization  @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  jobOpeningId   String?
  jobOpening     JobOpening?   @relation(fields: [jobOpeningId], references: [id])
  stageId        String
  stage          PipelineStage @relation(fields: [stageId], references: [id])
  ownerId        String?
  owner          User?         @relation("CandidateOwner", fields: [ownerId], references: [id])
  name           String
  email          String?
  phone          String?
  source         String?
  declineReason  String?
  notes          String?
  archivedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  createdById    String?
  updatedById    String?

  onboardings Onboarding[]
  tasks       Task[]
}

model Task {
  id             String       @id @default(cuid())
  organizationId String
  organization   Organization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  assigneeId     String?
  assignee       User?        @relation("TaskAssignee", fields: [assigneeId], references: [id])
  jobOpeningId   String?
  jobOpening     JobOpening?  @relation(fields: [jobOpeningId], references: [id])
  candidateId    String?
  candidate      Candidate?   @relation(fields: [candidateId], references: [id])
  onboardingId   String?
  onboarding     Onboarding?  @relation(fields: [onboardingId], references: [id])
  title          String
  description    String?
  status         TaskStatus   @default(TODO)
  priority       TaskPriority @default(MEDIUM)
  dueDate        DateTime?
  archivedAt     DateTime?
  createdAt      DateTime     @default(now())
  updatedAt      DateTime     @updatedAt
  createdById    String?
  updatedById    String?
}

model Employee {
  id             String         @id @default(cuid())
  organizationId String
  organization   Organization   @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  userId         String?        @unique
  user           User?          @relation(fields: [userId], references: [id])
  name           String
  email          String?
  document       String?
  employmentType EmploymentType
  role           String?
  area           String?
  startDate      DateTime?
  status         String         @default("ACTIVE")
  pjCompanyName  String?
  pjCnpj         String?
  archivedAt     DateTime?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  createdById    String?
  updatedById    String?
}

model Onboarding {
  id              String           @id @default(cuid())
  organizationId  String
  organization    Organization     @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  candidateId     String?
  candidate       Candidate?       @relation(fields: [candidateId], references: [id])
  responsibleId   String?
  responsible     User?            @relation("OnboardingResponsible", fields: [responsibleId], references: [id])
  employeeName    String
  employmentType  EmploymentType
  status          OnboardingStatus @default(STARTED)
  signatureStatus SignatureStatus  @default(PENDING)
  documents       Json?
  archivedAt      DateTime?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt
  createdById     String?
  updatedById     String?

  events            OnboardingEvent[]
  tasks             Task[]
  attachedDocuments OnboardingDocument[]
}

model OnboardingDocument {
  id             String     @id @default(cuid())
  onboardingId   String
  onboarding     Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  organizationId String
  filename       String
  mimeType       String
  size           Int
  storageKey     String?
  contentBase64  String?
  uploadedById   String?
  uploadedBy     User?      @relation(fields: [uploadedById], references: [id])
  createdAt      DateTime   @default(now())
}

model OnboardingEvent {
  id           String     @id @default(cuid())
  onboardingId String
  onboarding   Onboarding @relation(fields: [onboardingId], references: [id], onDelete: Cascade)
  type         String
  message      String
  createdById  String?
  createdAt    DateTime   @default(now())
}

model AuditLog {
  id             String        @id @default(cuid())
  organizationId String?
  organization   Organization? @relation(fields: [organizationId], references: [id])
  userId         String
  user           User          @relation(fields: [userId], references: [id])
  action         String
  entityType     String
  entityId       String?
  details        String?
  createdAt      DateTime      @default(now())
}
