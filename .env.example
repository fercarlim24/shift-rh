# Postgres — Supabase (recomendado) ou Neon
# Supabase: Project Settings → Database → Connection string → URI

# App / Vercel runtime — Transaction pooler (Supabase porta 6543)
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:6543/postgres?pgbouncer=true"

# Migrations (prisma migrate deploy) — Session ou Direct (porta 5432)
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-sa-east-1.pooler.supabase.com:5432/postgres"

# Neon: use Pooled em DATABASE_URL e Direct em DIRECT_URL (ver docs/DEPLOY.md)
