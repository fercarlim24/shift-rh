# Postgres (Neon recomendado para Vercel)
# Crie um projeto em https://neon.tech e copie as URLs do dashboard.

# Conexão pooled — use no app e na Vercel (Runtime)
DATABASE_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Conexão direta — use para migrations (`prisma migrate deploy`)
# No Neon: copie a URL "Direct connection" (sem pooler)
DIRECT_URL="postgresql://USER:PASSWORD@HOST/DB?sslmode=require"

# Se não usar pooler, pode repetir a mesma URL nas duas variáveis.
